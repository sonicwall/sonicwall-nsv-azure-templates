{
    "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
    "handler": "Microsoft.Azure.CreateUIDef",
    "version": "0.1.2-preview",
    "parameters": {
        "basics": [
            {
                "name": "vmNameInfo",
                "type": "Microsoft.Common.InfoBox",
                "visible": "[or(equals(basics('vmName'), ''), equals(basics('vmName'), steps('instanceDetails').vnetSpec.name), equals(basics('vmName'), steps('instanceDetails').storageSpec.name))]",
                "options": {
                    "icon": "Info",
                    "text": "The VM Name should not match the Storage Account or Virtual Network resource names."
                }
            },
            {
                "name": "vmName",
                "type": "Microsoft.Common.TextBox",
                "label": "VM Name",
                "toolTip": "The name of the new VM instance. It is recommended to use a unique name within the resource group. The name should not match the name of the Storage Account or the Virtual Network resources.",
                "constraints": {
                    "required": true,
                    "regex": "^[a-zA-Z0-9]{3,24}$",
                    "validationMessage": "VM names must be between 3 and 24 characters long, and can contain only numbers and letters."
                }
            },
            {
                "name": "usernameinfo",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                    "icon": "None",
                    "text": "SSH username: \"management\""
                }
            },
            {
                "name": "SSHCredentials",
                "type": "Microsoft.Compute.CredentialsCombo",
                "label": {
                    "authenticationType": "Authentication type",
                    "password": "Password",
                    "confirmPassword": "Confirm password",
                    "sshPublicKey": "SSH public key"
                },
                "toolTip": {
                    "authenticationType": "Authentication Type for the SonicWall NSv",
                    "password": "Password for the Virtual Machine",
                    "sshPublicKey": "SSH Public Key for the SonicWall NSv"
                },
                "constraints": {
                    "required": true
                },
                "options": {
                    "hideConfirmation": false
                },
                "osPlatform": "Linux"
            }
        ],
        "steps": [
            {
                "name": "instanceDetails",
                "label": "Instance Details",
                "subLabel": {
                    "preValidation": "Configure Instance Details",
                    "postValidation": "Done"
                },
                "bladeTitle": "Instance Details",
                "elements": [
                    {
                        "name": "nsvModel",
                        "type": "Microsoft.Common.DropDown",
                        "label": "NSv model",
                        "defaultValue": "NSv XS",
                        "toolTip": "The SonicWall NSv model to deploy. The model determines which image generation is used and which VM sizes are available.",
                        "constraints": {
                            "allowedValues": [
                                {
                                    "label": "NSv 270",
                                    "value": "NSv 270"
                                },
                                {
                                    "label": "NSv 470",
                                    "value": "NSv 470"
                                },
                                {
                                    "label": "NSv 870",
                                    "value": "NSv 870"
                                },
                                {
                                    "label": "NSv XS",
                                    "value": "NSv XS"
                                },
                                {
                                    "label": "NSv S",
                                    "value": "NSv S"
                                },
                                {
                                    "label": "NSv M",
                                    "value": "NSv M"
                                },
                                {
                                    "label": "NSv L",
                                    "value": "NSv L"
                                }
                            ],
                            "required": true
                        },
                        "visible": true
                    },
                    {
                        "name": "gen7Plan",
                        "type": "Microsoft.Common.DropDown",
                        "label": "NSv plan",
                        "defaultValue": "NSv 7.1 or newer",
                        "toolTip": "The NSv plan (also known as SKU) for gen7 models. Choose \"NSv 7.1 or newer\" unless you specifically need the legacy 7.0 image.",
                        "constraints": {
                            "allowedValues": [
                                {
                                    "label": "NSv 7.0 (legacy)",
                                    "value": "snwl-nsv-byol"
                                },
                                {
                                    "label": "NSv 7.1 or newer",
                                    "value": "snwl-nsv-scx"
                                }
                            ],
                            "required": true
                        },
                        "visible": "[or(or(equals(steps('instanceDetails').nsvModel, 'NSv 270'), equals(steps('instanceDetails').nsvModel, 'NSv 470')), equals(steps('instanceDetails').nsvModel, 'NSv 870'))]"
                    },
                    {
                        "name": "gen8PlanInfo",
                        "type": "Microsoft.Common.InfoBox",
                        "options": {
                            "icon": "Info",
                            "text": "NSv XS, S, M and L deploy from the gen8 plan \"snwl-nsv-scx-gen8\"."
                        },
                        "visible": "[not(or(or(equals(steps('instanceDetails').nsvModel, 'NSv 270'), equals(steps('instanceDetails').nsvModel, 'NSv 470')), equals(steps('instanceDetails').nsvModel, 'NSv 870')))]"
                    },
                    {
                        "name": "vmSize270",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv 270",
                        "toolTip": "Sizes certified for the NSv 270 model.",
                        "recommendedSizes": [
                            "Standard_DS2_v2",
                            "Standard_D2_v2",
                            "Standard_D2s_v4"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_DS2_v2",
                                "Standard_D2_v2",
                                "Standard_B2ms",
                                "Standard_D2_v4",
                                "Standard_D2ds_v4",
                                "Standard_D2s_v4",
                                "Standard_D3_v2",
                                "Standard_DS3_v2"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "[steps('instanceDetails').gen7Plan]"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv 270')]"
                    },
                    {
                        "name": "vmSize470",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv 470",
                        "toolTip": "Sizes certified for the NSv 470 model.",
                        "recommendedSizes": [
                            "Standard_D4s_v4",
                            "Standard_D3_v2",
                            "Standard_D4_v4"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_D4s_v4",
                                "Standard_D3_v2",
                                "Standard_D4_v4",
                                "Standard_D4d_v4",
                                "Standard_D4ds_v4"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "[steps('instanceDetails').gen7Plan]"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv 470')]"
                    },
                    {
                        "name": "vmSize870",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv 870",
                        "toolTip": "Sizes certified for the NSv 870 model.",
                        "recommendedSizes": [
                            "Standard_DS4_v2",
                            "Standard_D4_v2",
                            "Standard_D8_v4"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_DS4_v2",
                                "Standard_D4_v2",
                                "Standard_A8_v2",
                                "Standard_F8",
                                "Standard_F8s",
                                "Standard_D8_v3",
                                "Standard_D8s_v3",
                                "Standard_D8_v4"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "[steps('instanceDetails').gen7Plan]"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv 870')]"
                    },
                    {
                        "name": "vmSizeXS",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv XS",
                        "toolTip": "Sizes certified for the NSv XS model.",
                        "recommendedSizes": [
                            "Standard_DS1_v2",
                            "Standard_B1ms",
                            "Standard_DC1s_v3"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_DS1_v2",
                                "Standard_B1ms",
                                "Standard_DC1ds_v3",
                                "Standard_DC1s_v3",
                                "Standard_F1s",
                                "Standard_DS12-1_v2"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "snwl-nsv-scx-gen8"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv XS')]"
                    },
                    {
                        "name": "vmSizeS",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv S",
                        "toolTip": "Sizes certified for the NSv S model.",
                        "recommendedSizes": [
                            "Standard_D2ds_v4",
                            "Standard_D2s_v4",
                            "Standard_D2d_v4"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_D2d_v4",
                                "Standard_D2ds_v4",
                                "Standard_D2s_v4"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "snwl-nsv-scx-gen8"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv S')]"
                    },
                    {
                        "name": "vmSizeM",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv M",
                        "toolTip": "Sizes certified for the NSv M model.",
                        "recommendedSizes": [
                            "Standard_D4s_v4",
                            "Standard_D4ds_v4",
                            "Standard_D4_v4"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_D4_v4",
                                "Standard_D4s_v4",
                                "Standard_D4d_v4",
                                "Standard_D4ds_v4"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "snwl-nsv-scx-gen8"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv M')]"
                    },
                    {
                        "name": "vmSizeL",
                        "type": "Microsoft.Compute.SizeSelector",
                        "label": "Virtual machine size for NSv L",
                        "toolTip": "Sizes certified for the NSv L model.",
                        "recommendedSizes": [
                            "Standard_D8_v4",
                            "Standard_D8s_v3",
                            "Standard_D8_v3"
                        ],
                        "constraints": {
                            "allowedSizes": [
                                "Standard_D8_v4",
                                "Standard_D8_v3",
                                "Standard_D8s_v3"
                            ]
                        },
                        "osPlatform": "Linux",
                        "imageReference": {
                            "publisher": "sonicwall-inc",
                            "offer": "sonicwall-nsz-azure",
                            "sku": "snwl-nsv-scx-gen8"
                        },
                        "count": "1",
                        "visible": "[equals(steps('instanceDetails').nsvModel, 'NSv L')]"
                    },
                    {
                        "name": "imageVersionChoice",
                        "type": "Microsoft.Common.OptionsGroup",
                        "label": "Image version",
                        "defaultValue": "latest",
                        "toolTip": "Choose \"latest\" to always deploy the newest available image, or select a specific version to pin the deployment.",
                        "constraints": {
                            "allowedValues": [
                                {
                                    "label": "latest (always newest)",
                                    "value": "latest"
                                },
                                {
                                    "label": "Specific version",
                                    "value": "specific"
                                }
                            ],
                            "required": true
                        },
                        "visible": true
                    },
                    {
                        "name": "imageVersionsList",
                        "type": "Microsoft.Solutions.ArmApiControl",
                        "request": {
                            "method": "GET",
                            "path": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Compute/locations/', location(), '/publishers/sonicwall-inc/artifacttypes/vmimage/offers/sonicwall-nsz-azure/skus/', if(or(or(equals(steps('instanceDetails').nsvModel, 'NSv 270'), equals(steps('instanceDetails').nsvModel, 'NSv 470')), equals(steps('instanceDetails').nsvModel, 'NSv 870')), steps('instanceDetails').gen7Plan, 'snwl-nsv-scx-gen8'), '/versions?api-version=2022-08-01')]"
                        }
                    },
                    {
                        "name": "imageVersionPinned",
                        "type": "Microsoft.Common.DropDown",
                        "label": "Specific version",
                        "toolTip": "Select the exact image version to deploy.",
                        "constraints": {
                            "allowedValues": "[map(steps('instanceDetails').imageVersionsList, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                            "required": true
                        },
                        "visible": "[equals(steps('instanceDetails').imageVersionChoice, 'specific')]"
                    },
                    {
                        "name": "vNetInfoBox",
                        "type": "Microsoft.Common.InfoBox",
                        "visible": "[equals(basics('vmName'), steps('instanceDetails').vnetSpec.name)]",
                        "options": {
                            "icon": "Warning",
                            "text": "The Virtual Network's name should not match the VM Name on the Basics tab."
                        }
                    },
                    {
                        "name": "vnetSpec",
                        "type": "Microsoft.Network.VirtualNetworkCombo",
                        "label": {
                            "virtualNetwork": "Virtual Network",
                            "subnets": "Subnets"
                        },
                        "toolTip": {
                            "virtualNetwork": "Virtual Network the instance will be placed in.",
                            "subnets": "Subnet definitons for WAN and LAN zone."
                        },
                        "defaultValue": {
                            "name": "fwVirtualNet",
                            "addressPrefixSize": "/16"
                        },
                        "constraints": {
                            "minAddressPrefixSize": "/29"
                        },
                        "subnets": {
                            "subnet1": {
                                "label": "WAN X1 subnet",
                                "defaultValue": {
                                    "name": "WAN-X1",
                                    "addressPrefixSize": "/24"
                                },
                                "constraints": {
                                    "minAddressPrefixSize": "/29",
                                    "minAddressCount": 1,
                                    "requireContiguousAddresses": true
                                }
                            },
                            "subnet2": {
                                "label": "LAN X0 subnet",
                                "defaultValue": {
                                    "name": "LAN-X0",
                                    "addressPrefixSize": "/24"
                                },
                                "constraints": {
                                    "minAddressPrefixSize": "/29",
                                    "minAddressCount": 4,
                                    "requireContiguousAddresses": true
                                }
                            }
                        }
                    },
                    {
                        "name": "publicIpAddress",
                        "type": "Microsoft.Network.PublicIpAddressCombo",
                        "label": {
                            "publicIpAddress": "Public IP Address",
                            "domainNameLabel": "DNS Prefix for the public IP Address"
                        },
                        "toolTip": {
                            "publicIpAddress": "Public IP Address for the SonicWall NSv",
                            "domainNameLabel": "DNS Prefix for the public IP Address, must be globally unique"
                        },
                        "defaultValue": {
                            "publicIpAddressName": "[concat(basics('vmName'), '-ip')]",
                            "domainNameLabel": "[concat(basics('vmName'), '-', take(replace(guid(), '-', ''), 10))]"
                        },
                        "constraints": {
                            "required": {
                                "domainNameLabel": true
                            }
                        },
                        "options": {
                            "hideExisting": false,
                            "hideNone": false
                        }
                    },
                    {
                        "name": "managementCidr",
                        "type": "Microsoft.Common.TextBox",
                        "label": "Management source IP",
                        "toolTip": "Public IP address allowed access SonicWall NSv HTTPS & SSH management",
                        "constraints": {
                            "required": true,
                            "regex": "^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$",
                            "validationMessage": "Please enter a valid IPv4 address"
                        },
                        "visible": true
                    },
                    {
                        "name": "storageNameInfo",
                        "type": "Microsoft.Common.InfoBox",
                        "visible": "[equals(basics('vmName'), steps('instanceDetails').storageSpec.name)]",
                        "options": {
                            "icon": "Warning",
                            "text": "The selected Storage Account's name should not match the VM Name on the Basics tab."
                        }
                    },
                    {
                        "name": "storageSpec",
                        "type": "Microsoft.Storage.StorageAccountSelector",
                        "label": "Storage Account",
                        "toolTip": "Storage account to be used for disk blobs and diagnostics.",
                        "defaultValue": {
                            "type": "Standard_LRS"
                        },
                        "constraints": {
                            "allowedTypes": [
                                "Standard_LRS",
                                "Standard_GRS"
                            ]
                        }
                    }
                ]
            }
        ],
        "outputs": {
            "vmName": "[basics('vmName')]",
            "nsvModel": "[steps('instanceDetails').nsvModel]",
            "imageSku": "[if(or(or(equals(steps('instanceDetails').nsvModel, 'NSv 270'), equals(steps('instanceDetails').nsvModel, 'NSv 470')), equals(steps('instanceDetails').nsvModel, 'NSv 870')), steps('instanceDetails').gen7Plan, 'snwl-nsv-scx-gen8')]",
            "vmSize": "[if(equals(steps('instanceDetails').nsvModel, 'NSv 270'), steps('instanceDetails').vmSize270, if(equals(steps('instanceDetails').nsvModel, 'NSv 470'), steps('instanceDetails').vmSize470, if(equals(steps('instanceDetails').nsvModel, 'NSv 870'), steps('instanceDetails').vmSize870, if(equals(steps('instanceDetails').nsvModel, 'NSv XS'), steps('instanceDetails').vmSizeXS, if(equals(steps('instanceDetails').nsvModel, 'NSv S'), steps('instanceDetails').vmSizeS, if(equals(steps('instanceDetails').nsvModel, 'NSv M'), steps('instanceDetails').vmSizeM, if(equals(steps('instanceDetails').nsvModel, 'NSv L'), steps('instanceDetails').vmSizeL, '')))))))]",
            "imageVersion": "[if(equals(steps('instanceDetails').imageVersionChoice, 'latest'), 'latest', steps('instanceDetails').imageVersionPinned)]",
            "authenticationType": "[basics('SSHCredentials').authenticationType]",
            "SSHPassword": "[coalesce(basics('SSHCredentials').password, basics('SSHCredentials').sshPublicKey)]",
            "sshKey": "[coalesce(basics('SSHCredentials').password, basics('SSHCredentials').sshPublicKey)]",
            "virtualNetworkNewOrExisting": "[steps('instanceDetails').vnetSpec.newOrExisting]",
            "virtualNetworkResourceGroupName": "[steps('instanceDetails').vnetSpec.resourceGroup]",
            "virtualNetworkName": "[steps('instanceDetails').vnetSpec.name]",
            "virtualNetworkAddressPrefix": "[steps('instanceDetails').vnetSpec.addressPrefixes]",
            "subnetWANName": "[steps('instanceDetails').vnetSpec.subnets.subnet1.name]",
            "subnetWANPrefix": "[steps('instanceDetails').vnetSpec.subnets.subnet1.addressPrefix]",
            "subnetLANName": "[steps('instanceDetails').vnetSpec.subnets.subnet2.name]",
            "subnetLANPrefix": "[steps('instanceDetails').vnetSpec.subnets.subnet2.addressPrefix]",
            "storageAccountNewOrExisting": "[steps('instanceDetails').storageSpec.newOrExisting]",
            "existingStorageAccountRG": "[steps('instanceDetails').storageSpec.resourceGroup]",
            "storageAccount": "[steps('instanceDetails').storageSpec.name]",
            "storageAccountType": "[steps('instanceDetails').storageSpec.type]",
            "managementAccessIPSource": "[steps('instanceDetails').managementCidr]",
            "publicIpNewOrExisting": "[steps('instanceDetails').publicIpAddress.newOrExistingOrNone]",
            "publicIpName": "[steps('instanceDetails').publicIpAddress.name]",
            "publicIpDns": "[steps('instanceDetails').publicIpAddress.domainNameLabel]",
            "publicIpResourceGroupName": "[steps('instanceDetails').publicIpAddress.resourceGroup]",
            "publicIpAllocationMethod": "[steps('instanceDetails').publicIpAddress.publicIPAllocationMethod]",
            "publicIpSku": "[steps('instanceDetails').publicIpAddress.sku]",
            "location": "[location()]"
        }
    }
}
